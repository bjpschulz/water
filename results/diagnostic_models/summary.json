        "hour",
        "dow_local",
        "weekend",
        "lag_1",
        "lag_5",
        "lag_15",
        "lag_30",
        "lag_60",
        "lag_1440",
        "lag_10080"
      ],
      "params": {
        "n_estimators": 100,
        "num_leaves": 31,
        "learning_rate": 0.1,
