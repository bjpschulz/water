{
  "purpose": "Diagnostic check: do calendar + lag features let a simple model clear the naive/seasonal-naive floor by a real margin. Not a final, tuned model -- see AGENTS.md Stage 3/4.",
  "target": "avg_rate",
  "resolution": "1-minute",
  "evaluation_split": "validation",
  "input_feature_table": "data/processed/whw_features_v1.parquet",
